# /opt/elitefit-app/.env — configuración del servidor (no se sube a GitHub)
# Después de cambiarlo:  systemctl restart elitefit-app

# Dominio público de la app (sin https:// en RP_ID, con https:// en ORIGIN)
RP_ID=app.elitefit.ec
ORIGIN=https://app.elitefit.ec
# Nombre que aparece al crear la passkey
RP_NAME=Elite Fit

# Administradores: ids de usuario separados por coma (ver: bash deploy/usuarios.sh)
ADMIN_UIDS=
# 1 = solo se puede registrar quien tenga un código de invitación (lo generas en el panel admin)
INVITE_ONLY=0
